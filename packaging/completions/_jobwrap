#compdef jobwrap
# zsh completion for jobwrap

_jobwrap() {
    local -a subcommands
    subcommands=(
        'wrap:Run a command under jobwrap'
        'list:List registered jobs'
        'show:Show job details'
        'logs:Print a job output log'
        'attach:Attach to a job (experimental)'
        'signal:Send a named signal'
        'stop:Send SIGTERM'
        'open:Open the web interface'
        'daemon:Manage the daemon'
        'config:Manage configuration'
        'auth:Manage password authentication'
        'token:Manage API tokens'
        'launch:Launch a managed process (experimental)'
        'attach-launch:Attach a launch helper'
        'inspect:Inspect executable metadata'
        'terminals:List registered terminals'
        'help:Show help'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' subcommands
        _files
        return
    fi

    case "${words[2]}" in
        signal)
            if (( CURRENT == 4 )); then
                _values 'signal' int term hup quit stop cont kill
            fi
            ;;
        daemon)
            if (( CURRENT == 3 )); then
                _values 'action' status start stop restart
            elif [[ "${words[3]}" == start ]]; then
                _values 'option' --foreground --help
            fi
            ;;
        config)
            _values 'action' path init validate effective explain
            ;;
        auth)
            _values 'action' set-password remove-password status
            ;;
        token)
            _values 'action' create list revoke
            ;;
    esac
}

_jobwrap "$@"
